[Unit]
Description=FuelSeeker Fuel Data Update
After=network.target

[Service]
Type=oneshot
User=root

# Resource limits - adjust based on your server
CPUQuota=25%                    # Max 25% of one CPU core
CPUQuotaPeriodSec=100ms
MemoryMax=512M                  # Hard memory limit
MemorySwapMax=0                 # Prevent swap usage
TasksMax=50                     # Limit concurrent threads/processes
IOWeight=10                     # Low disk I/O priority (1-1000)

# Nice/ionice for additional fairness
Nice=10
IOSchedulingClass=idle

# The script
ExecStart=/usr/local/bin/fuel-update-with-vpn.sh

# Note: Logging is handled by the script itself, not systemd
# This prevents duplicate log entries
