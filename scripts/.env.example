# Fuelseeker - Environment Variables
# Copy this file to .env and fill in your actual API credentials

# Gov.uk Fuel Finder API Credentials
# Get these from: https://www.fuel-finder.service.gov.uk
FUEL_CLIENT_ID=your_fuel_client_id_here
FUEL_CLIENT_SECRET=your_fuel_client_secret_here

# Ordnance Survey API Credentials
# Get these from: https://osdatahub.os.uk/
OS_API_KEY=your_os_api_key_here
OS_API_SECRET=your_os_api_secret_here
