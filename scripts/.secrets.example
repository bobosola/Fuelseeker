# Fuelseeker - Secret Configuration
# Copy this file to .secrets and fill in your actual API credentials
# 
# WARNING: Keep this file secure - it contains sensitive API credentials!
# This file is loaded by config.php and values are defined as PHP constants.
#
# ***********************************************************
# Caddy users: BEWARE!
# ***********************************************************
# Unlike Apache/nginx, Caddy does NOT hide dotfiles
# by default. This could expose your `.secrets` file containing API
# credentials. You will need to add this to your Caddyfile:
#
#   file_server {
#       # hide secrets file & data folder
#       hide .secrets data
#   }

# Ordnance Survey API Credentials
# Get these from: https://osdatahub.os.uk/
OS_API_KEY=your_os_api_key_here
OS_API_SECRET=your_os_api_secret_here

# Security Key to upload SQLite file from local PC to remote geo-locked server
# Must match the DEPLOY_API_KEY on the UK PC (data_retrieval_server/.secrets)
DEPLOY_API_KEY=your_deployment_key_here

# CORS Allowed Origins (comma-separated list)
# These domains are allowed to access the API. Add your development URLs here.
# Examples: localhost, local IP addresses, staging domains
# Default includes production domains + common localhost ports
ALLOWED_ORIGINS=https://fuelseeker.net,https://othersite,https://localsite
