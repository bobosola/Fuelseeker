# Fuelseeker - Secret Configuration
# Copy this file to .secrets and fill in your actual API credentials
# 
# WARNING: Keep this file secure - it contains sensitive API credentials!
# This file is loaded by config.php and values are defined as PHP constants.
#
# ***********************************************************
# Caddy users: BEWARE!
# ***********************************************************
# Unlike Apache/nginx, Caddy does NOT hide dotfiles
# by default. This could expose your `.secrets` file containing API
# credentials. You will need to add this to your Caddyfile:
#
#   file_server {
#       # hide secrets file & data folder
#       hide .secrets data
#   }

# Gov.uk Fuel Finder API Credentials
# Get these from: https://www.fuel-finder.service.gov.uk
FUEL_CLIENT_ID=your_fuel_client_id_here
FUEL_CLIENT_SECRET=your_fuel_client_secret_here

# Security Key to upload SQLite file from local PC to remote geo-locked server
# Must match the DEPLOY_API_KEY on the web server (scripts/.secrets)
DEPLOY_API_KEY=your_deployment_key_here

# Deployment URL (optional - defaults to https://fuelseeker.net/scripts/db_deploy.php)
# Uncomment and modify if your web server uses a different domain
# DEPLOY_URL=https://your-domain.com/scripts/db_deploy.php

# Compression (optional - defaults to enabled)
# Gzip compression reduces upload size by ~60-70% (13MB → ~4-5MB)
# Only disable if you have issues with the zlib extension
# USE_GZIP=true
