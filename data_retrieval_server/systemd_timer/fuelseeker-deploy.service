[Unit]
Description=FuelSeeker Database Deployment to Remote Server
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bobosola

# Working directory where deploy_to_remote_server.php is located
WorkingDirectory=/home/bobosola/fuelseeker

# Run the deployment script
ExecStart=/usr/bin/php deploy_to_remote_server.php

# The PHP script already handles its own file logging via logMsg().
# Do NOT redirect systemd stdout/stderr to the same log file or every
# line will be duplicated.
StandardOutput=journal
StandardError=journal

# Restart on failure (e.g. network not ready after wake)
Restart=on-failure
RestartSec=120

# Resource limits
CPUQuota=50%
MemoryMax=256M
Nice=5

[Install]
WantedBy=multi-user.target
